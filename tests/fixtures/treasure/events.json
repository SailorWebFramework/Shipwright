            "bubbles": false,
            "cancelable": false,
            "data": null
        },
        "lostpointercapture": {
            "description": "Fired when pointer capture is released.",
            "category": "pointer",
            "js_event": "lostpointercapture",
            "interface": "PointerEvent",
            "bubbles": false,
            "cancelable": false,
            "data": null
        },
        "drag": {
            "description": "Fired continuously while the element is being dragged.",
            "category": "drag",
            "js_event": "drag",
            "interface": "DragEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "dragstart": {
            "description": "Fired when the user starts dragging the element.",
            "category": "drag",
            "js_event": "dragstart",
