            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "cut": {
            "description": "Fired when the user cuts content to the clipboard.",
            "category": "clipboard",
            "js_event": "cut",
            "interface": "ClipboardEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "paste": {
            "description": "Fired when the user pastes content from the clipboard.",
            "category": "clipboard",
            "js_event": "paste",
            "interface": "ClipboardEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
