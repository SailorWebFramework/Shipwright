                            "description": "The current playback position in seconds."
                        }
                    }
                },
                "volumechange": {
                    "description": "Fired when the volume has changed.",
                    "category": "media",
                    "js_event": "volumechange",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": {
                        "volume": {
                            "type": "float",
                            "path": "target.volume",
                            "description": "The current volume level (0.0 to 1.0)."
                        }
                    }
                },
                "seeking": {
                    "description": "Fired when a seek operation begins.",
                    "category": "media",
                    "js_event": "seeking",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "seeked": {
                    "description": "Fired when a seek operation completes.",
