            "cancelable": false,
            "data": null
        },
        "dragover": {
            "description": "Fired continuously while a dragged element is over a valid drop target.",
            "category": "drag",
            "js_event": "dragover",
            "interface": "DragEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "drop": {
            "description": "Fired when a dragged element is dropped on a valid drop target.",
            "category": "drag",
            "js_event": "drop",
