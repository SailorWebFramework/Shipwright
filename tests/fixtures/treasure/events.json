            "bubbles": true,
            "cancelable": false,
            "data": null
        },
        "dragenter": {
            "description": "Fired when a dragged element enters a valid drop target.",
            "category": "drag",
            "js_event": "dragenter",
            "interface": "DragEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "dragleave": {
            "description": "Fired when a dragged element leaves a valid drop target.",
