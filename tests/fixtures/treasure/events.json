        "pointerup": {
            "description": "Fired when a pointer is no longer active.",
            "category": "pointer",
            "js_event": "pointerup",
            "interface": "PointerEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "pointermove": {
            "description": "Fired when a pointer changes coordinates.",
