                    "description": "The name of the CSS animation that started."
                }
            }
        },
        "animationend": {
            "description": "Fired when a CSS animation completes.",
            "category": "animation",
            "js_event": "animationend",
            "interface": "AnimationEvent",
            "bubbles": true,
            "cancelable": false,
            "data": {
                "animationName": {
                    "type": "string",
                    "path": "animationName",
                    "description": "The name of the CSS animation that ended."
                }
            }
        },
        "animationiteration": {
            "description": "Fired when a CSS animation completes one iteration.",
            "category": "animation",
            "js_event": "animationiteration",
            "interface": "AnimationEvent",
            "bubbles": true,
            "cancelable": false,
            "data": {
                "animationName": {
                    "type": "string",
                    "path": "animationName",
                    "description": "The name of the CSS animation that iterated."
                }
            }
        },
