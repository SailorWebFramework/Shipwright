            "cancelable": false,
            "data": null
        },
        "scrollend": {
            "description": "Fired when scrolling has completed.",
            "category": "scroll",
            "js_event": "scrollend",
            "interface": "Event",
            "bubbles": true,
            "cancelable": false,
            "data": null
        },
        "input": {
            "description": "Fired when the value of an input, select, or textarea element changes. Technically a GlobalEventHandler but only produces meaningful data on form elements.",
            "category": "input",
            "js_event": "input",
            "interface": "InputEvent",
            "bubbles": true,
            "cancelable": false,
            "data": {
                "value": {
                    "type": "string",
                    "path": "target.value",
                    "description": "The current value of the element."
                }
            }
        },
        "change": {
            "description": "Fired when the value of an input, select, or textarea element is committed by the user. Differs from input in that it fires on commit (blur, Enter), not on every keystroke.",
            "category": "input",
            "js_event": "change",
            "interface": "Event",
            "bubbles": true,
            "cancelable": false,
            "data": {
                "value": {
                    "type": "string",
                    "path": "target.value",
                    "description": "The committed value of the element."
                }
            }
        },
        "select": {
            "description": "Fired when text is selected in an input or textarea element.",
            "category": "input",
            "js_event": "select",
            "interface": "Event",
            "bubbles": true,
            "cancelable": false,
            "data": null
        },
