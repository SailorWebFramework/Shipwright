    "targeted": {
        "form_submission": {
            "tags": ["form"],
            "events": {
                "submit": {
                    "description": "Fired when a form is submitted.",
                    "category": "form",
                    "js_event": "submit",
                    "interface": "SubmitEvent",
                    "bubbles": true,
                    "cancelable": true,
                    "data": null
                },
                "reset": {
                    "description": "Fired when a form is reset.",
                    "category": "form",
                    "js_event": "reset",
                    "interface": "Event",
                    "bubbles": true,
                    "cancelable": true,
                    "data": null
                },
                "formdata": {
                    "description": "Fired when a FormData object is constructed, after a form submission.",
                    "category": "form",
                    "js_event": "formdata",
                    "interface": "FormDataEvent",
                    "bubbles": true,
                    "cancelable": false,
                    "data": null
                }
            }
        },
        "media_playback": {
            "tags": ["audio", "video"],
            "events": {
                "play": {
                    "description": "Fired when playback begins after being paused or delayed.",
                    "category": "media",
                    "js_event": "play",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "pause": {
                    "description": "Fired when playback is paused.",
                    "category": "media",
                    "js_event": "pause",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "ended": {
                    "description": "Fired when playback reaches the end of the media.",
                    "category": "media",
                    "js_event": "ended",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "timeupdate": {
                    "description": "Fired when the current playback position changes.",
