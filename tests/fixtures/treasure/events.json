{
    "version": "1.0.0",
    "global": {
        "click": {
            "description": "Fired when the element is clicked.",
            "category": "mouse",
            "js_event": "click",
            "interface": "MouseEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "dblclick": {
            "description": "Fired when the element is double-clicked.",
            "category": "mouse",
            "js_event": "dblclick",
            "interface": "MouseEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "mousedown": {
            "description": "Fired when a mouse button is pressed on the element.",
            "category": "mouse",
            "js_event": "mousedown",
            "interface": "MouseEvent",
            "bubbles": true,
            "cancelable": true,
            "data": null
        },
        "mouseup": {
            "description": "Fired when a mouse button is released over the element.",
