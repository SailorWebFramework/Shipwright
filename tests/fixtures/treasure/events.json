            "js_event": "transitionend",
            "interface": "TransitionEvent",
            "bubbles": true,
            "cancelable": false,
            "data": {
                "propertyName": {
                    "type": "string",
                    "path": "propertyName",
                    "description": "The name of the CSS property associated with the transition."
                }
            }
        },
        "transitionrun": {
            "description": "Fired when a CSS transition is first created (before any delay).",
            "category": "transition",
            "js_event": "transitionrun",
            "interface": "TransitionEvent",
            "bubbles": true,
            "cancelable": false,
            "data": {
                "propertyName": {
                    "type": "string",
                    "path": "propertyName",
                    "description": "The name of the CSS property associated with the transition."
                }
            }
        },
        "transitioncancel": {
            "description": "Fired when a CSS transition is canceled.",
            "category": "transition",
            "js_event": "transitioncancel",
            "interface": "TransitionEvent",
            "bubbles": true,
            "cancelable": false,
            "data": {
                "propertyName": {
                    "type": "string",
                    "path": "propertyName",
                    "description": "The name of the CSS property associated with the transition."
                }
            }
        }
