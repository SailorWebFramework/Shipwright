        "pointercancel": {
            "description": "Fired when the browser determines the pointer is unlikely to produce further events.",
            "category": "pointer",
            "js_event": "pointercancel",
            "interface": "PointerEvent",
            "bubbles": true,
            "cancelable": false,
            "data": null
