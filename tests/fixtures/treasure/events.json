                    "js_event": "loadeddata",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "loadedmetadata": {
                    "description": "Fired when the metadata (duration, dimensions) has loaded.",
                    "category": "media",
                    "js_event": "loadedmetadata",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "canplay": {
                    "description": "Fired when enough data is available to start playback, but not enough to play through.",
                    "category": "media",
                    "js_event": "canplay",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "canplaythrough": {
                    "description": "Fired when enough data is available to play through to the end without buffering.",
                    "category": "media",
                    "js_event": "canplaythrough",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "waiting": {
                    "description": "Fired when playback has stopped because of a temporary lack of data.",
                    "category": "media",
                    "js_event": "waiting",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "stalled": {
                    "description": "Fired when the browser is trying to get media data, but data is not forthcoming.",
                    "category": "media",
                    "js_event": "stalled",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": null
                },
                "durationchange": {
                    "description": "Fired when the duration attribute of the media has been updated.",
                    "category": "media",
                    "js_event": "durationchange",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": {
                        "duration": {
                            "type": "float",
                            "path": "target.duration",
                            "description": "The updated duration of the media in seconds."
                        }
                    }
                },
                "ratechange": {
                    "description": "Fired when the playback rate has changed.",
                    "category": "media",
                    "js_event": "ratechange",
                    "interface": "Event",
                    "bubbles": false,
                    "cancelable": false,
                    "data": {
                        "playbackRate": {
                            "type": "float",
                            "path": "target.playbackRate",
                            "description": "The current playback rate."
                        }
                    }
                }
            }
